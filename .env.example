# Copy to .env for local development (scripts/dev.sh reads it).
# Production values live in /etc/wooddust/config.env (see docs/deployment.md).

# Postgres. Leave unset to serve data/ from memory (development only).
DATABASE_URL=postgres://localhost/wooddust_dev?sslmode=disable

# The server always binds 127.0.0.1; Apache is the public endpoint.
PORT=8080

SITE_NAME=Dust Almanac
# Origin used for canonical URLs, og:url and the sitemap. No trailing slash.
BASE_URL=http://localhost:8080

# Paths (relative to the working directory).
IMAGES_DIR=images
DATA_DIR=data
CONTENT_DIR=content

# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For. Production: Apache
# on the same host.
TRUSTED_PROXIES=127.0.0.1,::1

# Per-IP limit for /api/ (requests per minute, burst).
API_RATE_PER_MIN=120
API_RATE_BURST=60

# text or json
LOG_FORMAT=text

# ---- Development over http://localhost ------------------------------------
# Allows sign-in over plain http (Portiko DEV_INSECURE, insecure cookies).
# Refused for an https BASE_URL. Never set in production.
# DEV_INSECURE=true

# ---- Sign-in: embedded Portiko provider (PLAN §5, docs/portiko-integration.md)
# A separate database for Portiko's own tables. Leave unset to disable
# sign-in (the site works; /admin answers 503; API keys still work).
# IDENTITY_DATABASE_URL=postgres://localhost/wooddust_identity_dev?sslmode=disable
# Keys: generate each with `openssl rand -hex 32`.
# IDENTITY_CRYPTO_KEY=
# The site's client secret, registered once with `wooddust identity register-site`.
# IDENTITY_CLIENT_SECRET=
# IDENTITY_CLIENT_ID=wooddust
# Protects the sign-in redirect cookies (≥32 bytes).
# COOKIE_KEY=
# Opens passkey enrollment at /auth/enroll. Long and random; may be removed
# after the owner has enrolled.
# IDENTITY_BOOTSTRAP_CODE=
# SMTP for one-time codes. Unset: codes are printed to the log (dev only).
# IDENTITY_SMTP_HOST=
# IDENTITY_SMTP_PORT=587
# IDENTITY_SMTP_USERNAME=
# IDENTITY_SMTP_PASSWORD=
# IDENTITY_EMAIL_FROM=
# IDENTITY_TEMPLATE_DIR=

# ---- Anonymous submissions (contract §6, PLAN §6) ---------------------------
# Signs form tokens (and, unless IP_HASH_KEY is set, derives the IP-hash key).
# Unset: a random key per process (forms break on restart). openssl rand -hex 32
# FORM_TOKEN_KEY=
# IP_HASH_KEY=
# Ceilings (separate from the API GET rate limit above).
SUBMIT_PER_IP_HOUR=5
SUBMIT_PER_IP_DAY=20
SUBMIT_GLOBAL_DAY=200
SUBMIT_MIN_FILL_SECONDS=4
SUBMIT_FORM_MAX_AGE_HOURS=24
