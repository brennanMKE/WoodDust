# Rendered by scripts/provision.sh into /etc/systemd/system/@UNIT@.service
# (@UNIT@, @ENV_NAME@, @ROOT@, @ETC@ come from deploy/envs/<env>.env).
# PORT comes from photon's port registry drop-in, not from here.
[Unit]
Description=Dust Almanac web service (@UNIT@, @ENV_NAME@)
Documentation=https://github.com/brennanMKE/WoodDust
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=@UNIT@
Group=@UNIT@
# Release layout: @ROOT@/releases/<sha>/ with @ROOT@/current
# symlinked to the live one (docs/deployment.md). The working directory holds
# data/, content/ and images/; the binary has the SPA embedded.
WorkingDirectory=@ROOT@/current
EnvironmentFile=@ETC@/config.env
# Seed on every start so the published tables always match the release's
# data/. Seed is idempotent and runs in one transaction.
ExecStartPre=@ROOT@/current/bin/wooddust seed
ExecStart=@ROOT@/current/bin/wooddust serve
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

Environment=GOMEMLIMIT=200MiB
MemoryMax=320M
CPUQuota=150%

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Postgres is reached over its Unix socket; the only TCP peer is Apache on
# loopback. Widen this when SMTP for one-time codes is configured.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
