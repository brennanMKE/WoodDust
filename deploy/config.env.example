# /etc/wooddust/config.env (mode 0640, owner root:wooddust)
DATABASE_URL=postgres://wooddust@/wooddust?host=/var/run/postgresql
# PORT is not set here: photon's port registry supplies it (photon-ports).
SITE_NAME=Dust Almanac
BASE_URL=https://wooddust.sstools.co
IMAGES_DIR=images
DATA_DIR=data
CONTENT_DIR=content
TRUSTED_PROXIES=127.0.0.1,::1
LOG_FORMAT=json

# Sign-in (embedded Portiko). Each key: openssl rand -hex 32. See docs/deployment.md.
IDENTITY_DATABASE_URL=postgres://wooddust@/wooddust_identity?host=/var/run/postgresql
IDENTITY_CRYPTO_KEY=
IDENTITY_CLIENT_ID=wooddust
IDENTITY_CLIENT_SECRET=
COOKIE_KEY=
IDENTITY_BOOTSTRAP_CODE=
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=587
IDENTITY_SMTP_USERNAME=
IDENTITY_SMTP_PASSWORD=
IDENTITY_EMAIL_FROM=

# Anonymous submissions.
FORM_TOKEN_KEY=
SUBMIT_PER_IP_HOUR=5
SUBMIT_PER_IP_DAY=20
SUBMIT_GLOBAL_DAY=200
